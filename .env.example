# ═══ REQUIRED ═══
GROQ_API_KEY=your_groq_api_key_here
FLASK_SECRET_KEY=any-random-string-here

# ═══ MODELS (updated August 2026) ═══
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# ═══ RAM SETTINGS ═══
# For Render free tier (512MB): keep these values
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5

# ═══ FEATURES ═══
# Set VISION_ENABLED=false on free tier to save RAM
# Set true only if you have 1GB+ RAM
VISION_ENABLED=false
PII_MASKING=true

# ═══ ENV ═══
FLASK_ENV=production
LOG_LEVEL=WARNING
